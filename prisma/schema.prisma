generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSULTOR
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CompanyStatus {
  EM_DIAGNOSTICO
  EM_MAPEAMENTO
  EM_IMPLEMENTACAO
  EM_MANUTENCAO
  CONCLUIDO
  PAUSADO
}

// PROSPECT e LEADS representam a mesma coluna ("Leads") no funil do CRM —
// mantidos os dois para não quebrar leads já persistidos com PROSPECT.
enum LeadStatus {
  PROSPECT
  LEADS
  DIAGNOSTICO
  PROPOSTA
  FECHAMENTO
  GANHO
  PERDIDO
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  COMMENTED
}

enum ActivityEntity {
  TASK
  PROCESS
  SECTOR
  COMPANY
  DELIVERABLE
  COMMENT
}

enum NotificationType {
  INFO
  WARNING
  DANGER
}

// 1. O Usuário (equipe interna Tecnasa)
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // ID vindo do Clerk
  name      String
  email     String   @unique
  role      Role     @default(CONSULTOR)
  createdAt DateTime @default(now())

  tasks              Task[]
  deliverables       Deliverable[]
  comments           TaskComment[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  integrations       UserIntegration[]
  transcripts        Transcript[]
  diagnosticSessions DiagnosticSession[]
  pdcaMeetings       PdcaMeeting[]
}

// 2. Usuário Cliente (acesso ao portal)
model ClientUser {
  id        String   @id @default(cuid())
  clerkId   String   @unique // ID vindo do Clerk
  name      String
  email     String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 2. A Empresa/Cliente
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  logoUrl      String?
  cnpj         String?
  segment      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  website      String?
  notes        String?
  status       CompanyStatus @default(EM_DIAGNOSTICO)

  sectors            Sector[]
  deliverables       Deliverable[]
  clientUsers        ClientUser[]
  transcripts        Transcript[]
  diagnosticSessions DiagnosticSession[]
  pdcaMeetings       PdcaMeeting[]
}

// 3. O Setor
model Sector {
  id        String  @id @default(cuid())
  name      String
  pilar     String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  processes   Process[]
  transcripts Transcript[]
}

// 4. O Processo
model Process {
  id          String   @id @default(cuid())
  title       String
  description String?
  sectorId    String
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  tasks Task[]
}

// 5. A Tarefa
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  startDate DateTime?
  dueDate   DateTime?
  notes     String?
  driveLink String?

  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  comments  TaskComment[]
  createdAt DateTime      @default(now())
}

// 6. NOVO: Comentários por Tarefa
model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// 7. Módulo CRM: O Potencial Cliente (Lead)
model Lead {
  id          String     @id @default(cuid())
  name        String
  cnpj        String?
  contactRole String?
  segment     String?
  address     String?
  status      LeadStatus @default(PROSPECT)
  createdAt   DateTime   @default(now())

  interactions Interaction[]
}

// 8. Módulo CRM: Histórico de Interações
model Interaction {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 13. Histórico de Atividades
model ActivityLog {
  id          String         @id @default(cuid())
  action      ActivityAction
  entity      ActivityEntity
  entityId    String?
  description String
  companyId   String?
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  createdAt DateTime         @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// 11. Tipos de entregável personalizáveis
model DeliverableType {
  id        String   @id @default(cuid())
  label     String
  color     String   @default("bg-gray-100 text-gray-700")
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Deliverable {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("OUTRO")
  url       String
  notes     String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// 16. Integrações de usuário (Google Calendar, etc.)
model UserIntegration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "google"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model Transcript {
  id        String   @id @default(cuid())
  title     String
  content   String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sectorId  String?
  sector    Sector?  @relation(fields: [sectorId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  sessions DiagnosticSession[]
}

// 15. Sessões de diagnóstico com IA
model DiagnosticSession {
  id        String   @id @default(cuid())
  title     String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  Json     @default("[]")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transcripts Transcript[]
}

model PdcaMeeting {
  id        String   @id @default(cuid())
  date      DateTime
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  etapaPdca      String
  avancos        String?
  observacoes    String?
  decisoes       String?
  proximosPassos String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
